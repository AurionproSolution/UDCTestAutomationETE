{
  "name": "udc-automation-tests",
  "version": "1.0.0",
  "description": "UDC Automation Tests - Playwright TypeScript Framework for DO, RSS, and CSS Portals",
  "main": "index.js",
  "scripts": {
    "test": "npx playwright test",
    "test:headed": "npx playwright test --headed",
    "test:ui": "npx playwright test --ui",
    "test:debug": "npx playwright test --debug",
    "test:do": "npx playwright test --project=do-portal-chromium",
    "test:do:auth": "npx playwright test --project=do-portal-auth-setup",
    "test:do:session-unit": "npx playwright test --project=do-portal-unit",
    "test:do:sanity": "npx playwright test tests/do-portal/doSanityTest --project=do-portal-chromium",
    "test:do:perf": "npx playwright test --project=do-portal-perf-data",
    "test:rss": "npx playwright test --project=rss-portal-chromium",
    "test:rss:auth": "npx playwright test --project=rss-portal-auth-setup",
    "test:rss:sit": "cross-env TEST_ENV=sit npx playwright test --project=rss-portal-chromium",
    "test:css": "npx playwright test --project=css-portal-chromium",
    "test:smoke": "npx playwright test --project=all-portals-smoke",
    "test:regression": "npx playwright test --project=all-portals-regression",
    "test:all-portals": "npx playwright test --project=do-portal-chromium --project=rss-portal-chromium --project=css-portal-chromium",
    "test:env:dev": "cross-env TEST_ENV=dev npx playwright test",
    "test:env:qat": "cross-env TEST_ENV=qat npx playwright test",
    "test:env:sit": "cross-env TEST_ENV=sit npx playwright test",
    "test:do:sit": "cross-env TEST_ENV=sit npx playwright test --project=do-portal-chromium",
    "test:env:uat": "cross-env TEST_ENV=uat npx playwright test",
    "test:env:prod": "cross-env TEST_ENV=prod npx playwright test",
    "report": "npx playwright show-report my-report",
    "report:ortoni": "npx playwright show-report ortoni-report",
    "lint": "tsc --noEmit && eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rimraf test-results my-report ortoni-report"
  },
  "keywords": [
    "playwright",
    "typescript",
    "automation",
    "testing",
    "e2e",
    "udc",
    "do-portal",
    "rss-portal",
    "css-portal"
  ],
  "author": "UDC Team",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@playwright/test": "^1.41.0",
    "@types/node": "^20.11.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.15.0",
    "ortoni-report": "^4.0.8",
    "prettier": "^3.4.2",
    "rimraf": "^5.0.5",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.15.0"
  },
  "dependencies": {
    "dotenv": "^16.3.1",
    "speakeasy": "^2.0.0"
  }
}
